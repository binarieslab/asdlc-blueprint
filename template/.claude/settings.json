{
  "permissions": {
    "deny": [
      "Edit(/tool/**)",
      "Edit(/feature-map/scripts/**)",
      "Edit(/analysis_options.yaml)",
      "Edit(/.swiftlint.yml)",
      "Edit(/.swift-format)",
      "Edit(/eslint.config.*)",
      "Edit(/.eslintrc*)",
      "Edit(/.golangci.yml)",
      "Edit(/.golangci.yaml)",
      "Edit(/detekt.yml)",
      "Edit(/ruff.toml)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-lint-rules.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
